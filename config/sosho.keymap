//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

//スクロールモード用レイヤーの番号(keymap内の scroll レイヤー。overlay側の SCROLL_LAYER と合わせること)
#define SCROLL 4

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19はJのキー 20はKのキーに相当します。
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20 K 21 L
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19 J 21 L
	    combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

		//押している間スクロールモードのコンボ 21 L 22 ;
        combo_SCROLL_R {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>; //直前150ms以内に他のキーを打っていたら発動しない(誤爆防止)
            key-positions = <21 22>;
            bindings = <&mo SCROLL>;
        };

		//---- 左手側 ----
		//左クリックのコンボ 15 D 16 F
        combo_LCLK_L {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>; //直前150ms以内に他のキーを打っていたら発動しない(誤爆防止)
            key-positions = <15 16>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 14 S 15 D
        combo_RCLK_L {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>; //直前150ms以内に他のキーを打っていたら発動しない(誤爆防止)
            key-positions = <14 15>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 14 S 16 F (右手側の J+L に合わせて 90ms)
        combo_MCLK_L {
            timeout-ms = <90>;
            require-prior-idle-ms = <150>; //直前150ms以内に他のキーを打っていたら発動しない(誤爆防止)
            key-positions = <14 16>;
            bindings = <&mkp MCLK>;
        };

		//押している間スクロールモードのコンボ 13 A 14 S
        combo_SCROLL_L {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>; //直前150ms以内に他のキーを打っていたら発動しない(誤爆防止)
            key-positions = <13 14>;
            bindings = <&mo SCROLL>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp TAB    &kp Q   &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
            &kp LCTRL  &kp A   &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp ENTER
            &kp LSHFT  &kp Z   &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH &kp LSHFT
            &kp ESC    &kp LALT              &mo 2  &kp SPACE  &mo 1  &kp LA(GRAVE)              &mo 3     &kp LGUI
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &kp GRAVE &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6    &kp N7   &kp N8   &kp N9    &kp N0 &kp DEL
            &trans    &trans &trans &trans &trans &trans           &kp PG_UP &kp HOME &kp UP   &kp END   &trans &trans
            &trans    &trans &trans &trans &trans &trans           &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &trans &trans
            &trans    &trans               &trans &trans           &trans    &trans                      &trans &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &trans  &trans    &kp MINUS &kp EQUAL &trans     &trans
            &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &kp LBKT  &kp RBKT  &kp NUBS  &trans     &trans
            &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15    &trans  &kp SEMI  &kp SQT   &trans    &kp QMARK  &kp BSLH
            &trans &trans                  &trans  &trans     &trans  &trans                        &trans     &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            &trans &trans &trans &trans &trans &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &trans         &trans
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &bt BT_CLR_ALL &bt BT_CLR
            &trans &trans               &trans &trans      &trans  &out OUT_BLE                                    &trans         &trans
        >;
    };
    //押している間だけポインティングデバイスの動きをスクロールに変えるためのレイヤー(4番)。
    //キーはすべて透過(&trans)なので、このレイヤー中もキー入力は通常どおりです。
    //実際のスクロール変換は boards/shields/sosho/sosho_R_*.overlay の scroller で行います。
    scroll {
        display-name = "Scroll";
        bindings = <
            &trans &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans      &trans &trans &trans &trans &trans &trans
            &trans &trans               &trans &trans      &trans &trans               &trans &trans
        >;
    };

    extra2 {
        status = "reserved";
    };
};
};
